<!-- app/views/sessions/new.html.erb -->
<%= form_with url: login_path, class: "login__card" do |f| %>

  <h1 class="login__title">Login</h1>

  <div class="login__field">
    <%= f.label :username, class: "login__label" %>
    <%= f.text_field :username, required: true, class: "login__input" %>
  </div>

  <div class="login__field">
    <%= f.label :password, class: "login__label" %>
    <%= f.password_field :password, required: true, class: "login__input" %>
  </div>

  <% if flash[:alert] %>
    <p class="login__error"><%= flash[:alert] %></p>
  <% end %>

  <%= f.submit "Login", class: "login__button"%>
<% end %>


