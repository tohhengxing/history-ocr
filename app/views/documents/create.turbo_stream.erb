<% if @document.errors.any? %>
  <%= turbo_stream.replace "new_document", partial: "form", locals: { user: @document } %>
<% else %>
  <%= turbo_stream.append "documents", partial: "documents/document_row", locals: { d: @document } %>
  <%= turbo_stream.replace "new_document", partial: "documents/form", locals: { document: Document.new.tap { |d| d.build_task } } %>
<% end %>