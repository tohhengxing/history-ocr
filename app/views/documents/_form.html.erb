<%= turbo_frame_tag "new_document" do %>
  <%= form_with model: document, url: documents_path, data: { turbo_frame: "new_document"}, class: "documents-upload__card", html: {multipart: true} do |form| %>

  <h2 class="documents-upload__card__title">Upload document</h2>

  <% if flash[:error] %>
    <p style="color: red;"><%= flash[:error] %></p>
  <% end %>

  <div>
    <div class="documents-upload__card__field">
      <%= form.label :image, class: "documents-upload__card__label" %>
      <%= form.file_field :image, required: true %>
    </div>

    <div class="documents-upload__card__field">
      <%= form.fields_for :task do |task_fields| %>
        <%= form.label "Assigned user", class: "documents-upload__card__label" %>
        <%= task_fields.collection_select :user_id, User.all, :id, :username, prompt: "Select user" %>
      <% end %>
    </div>

    <div class="documents-upload__card__button_row">
      <%= form.submit "Upload", class: "documents-upload__card__button" %>
    </div>

  </div>
<% end %>
<% end %>