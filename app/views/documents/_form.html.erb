<%= form_with model: @document, url: documents_path, data: { turbo_frame: "new_document"}, class: "documents-upload__card" do |form| %>

  <h2 class="documents-upload__card__title">Upload document</h2>

  <% if flash[:error] %>
    <p style="color: red;"><%= flash[:error] %></p>
  <% end %>

  <div>
    <div class="documents-upload__card__field">
      <%= form.label :image, class: "documents-upload__card__label" %>
      <%= form.file_field :image %>
    </div>

    <div class="documents-upload__card__button_row">
      <%= form.submit "Upload", class: "documents-upload__card__button" %>
    </div>

  </div>
<% end %>

<%#= link_to 'Back', documents_path %>