<div class="documents-index-table__row">
  <div class="documents-index-table__cell"><%= d.name %></div>
  <div class="documents-index-table__cell">temp modified by</div>
  <div class="documents-index-table__cell">temp modified time</div>
  <div class="documents-index-table__cell">
      <%= link_to 'view', document_path(d) %>
      <%= link_to 'edit', edit_document_path(d) %>
      <%= button_to 'Delete', d, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>