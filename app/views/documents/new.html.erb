<h1>Upload document</h1>

<% if flash[:error] %>
  <p style="color: red;"><%= flash[:error] %></p>
<% end %>

<%= form_with model: @document do |form| %>
  <div>
    <div>
      <%= form.label :image %>
      <%= form.file_field :image %>
    </div>

    <div>
      <%= form.label :annotation %>
      <%= form.text_area :annotation %>
    </div>


    <%= form.submit "Upload" %>
  </div>
<% end %>

<%= link_to 'Back', documents_path %>