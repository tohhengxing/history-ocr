
<div class="documents-edit-container"
     data-controller="annotator"
     data-annotator-image-url-value="<%= url_for(@document.image) %>">
  <div class="documents-edit-container__card">
    <h2 class="documents-edit-container__card-title"><%= @document.name %></h2>
    <div style="height: 500px;">
      <div data-annotator-target="container"
           id="openseadragon-annotator"
           style="height: 100%; margin-bottom: 100px;"></div>
    </div>
  </div>

  <div class="documents-edit-container__card">
      <h2 class="documents-edit-container__card-title">Tasks</h2>
      <%= form_with model: @document, class: "documents-edit-container__card-form" do |form| %>

<!--        <div class="documents-edit-card__field">-->
          <%#= form.label :image, class: "documents-edit-card__label" %>
          <%#= form.file_field :image %>
          <%# if @document.image.attached? %>
<!--            <p>Current image: <%#= @document.image.filename %></p>-->
          <%# end %>
<!--        </div>-->

        <div class="documents-edit-container__card-form-question">
          <%= form.label :transcription, class: "documents-edit-container__card-form-label" %>
          <%= form.text_area :transcription, class: "documents-edit-container__card-form-text-area" %>
        </div>

        <div class="documents-edit-container__card-form-question">
          <%= form.label :translation, class: "documents-edit-container__card-form-label" %>
          <%= form.text_area :translation, class: "documents-edit-container__card-form-text-area" %>
        </div>

        <div class="documents-edit-container__card-form-question">
          <%= form.label :transliteration, class: "documents-edit-container__card-form-label" %>
          <%= form.text_area :transliteration, class: "documents-edit-container__card-form-text-area" %>
        </div>

      <% if current_user.admin? %>
        <div class="documents-edit-container__card-form-question">
          <%= form.fields_for :task do |task_fields| %>
            <%= form.label "Assigned user", class: "documents-edit-container__card-form-label" %>
            <%= task_fields.collection_select :user_id, User.all, :id, :username, prompt: "Select user" %>
          <% end %>
        </div>
      <% end %>

        <%= form.submit "Update", class: "documents-edit-container__card-form__button" %>
        <% if flash[:notice] %>
          <p style="color: green;text-align: center"><%= flash[:notice] %></p>
        <% end %>
      <% end %>
<!--      <div style="margin-top:100px;">-->
<!--        <%#= link_to 'Show', @document %> |-->
        <%#= link_to 'Back', documents_path %>
<!--      </div>-->
    </div>

</div>

